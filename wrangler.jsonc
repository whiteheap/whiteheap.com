{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Cloudflare's current form of Pages: a Worker that serves only static assets.
  // With no script, every request is an asset request, so none counts toward Worker request limits.
  "name": "whiteheap",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./dist"
  },
  "routes": [{ "pattern": "whiteheap.com", "custom_domain": true }],
  // Serve the site only at its canonical address.
  "workers_dev": false,
  "preview_urls": false
}
