{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // Sends www.whiteheap.com to https://whiteheap.com, keeping the path and query.
  "name": "whiteheap-www",
  "main": "index.ts",
  "compatibility_date": "2026-11-04",
  "routes": [{ "pattern": "www.whiteheap.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
