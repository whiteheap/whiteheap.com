---
/**
 * residue-ui's Worktrees screen, for the `shot` slot of its <Tool>: the
 * screenshot in its README's Screens section, docs/screenshots/worktrees.png
 * in whiteheap/residue-ui at d7c38226, 2360x1776, encoded as WebP with
 * `cwebp -m 6 -resize`: 880 px wide at -q 85 (27.8 KB) and 1760 px at -q 75
 * (54.0 KB), against 108 KB for the PNG. Take it again from that file when
 * the README's screenshot changes. The alt text is the README's, word for word.
 */
import small from "../assets/residue-ui-worktrees-880.webp";
import large from "../assets/residue-ui-worktrees-1760.webp";

const alt =
  "The Worktrees screen: a line that says automatic cleanup freed about 70.3 MB, 1 worktree, since the app was last open, with a link to Freed. Below it, 1.3 GB reclaimable, 6 of 11 worktrees can go, about 975 MB freed in the last 7 days. A treemap sizes each worktree by the space removing it frees, grouped by repository: white for can go, gray for kept, hatched for unknown. Below it, each worktree's checks and verdict.";
---

<figure class="tool-shot">
  <img
    src={small.src}
    srcset={`${small.src} ${small.width}w, ${large.src} ${large.width}w`}
    sizes="(min-width: 72rem) 54rem, 100vw"
    width={small.width}
    height={small.height}
    alt={alt}
    loading="lazy"
    decoding="async"
  />
  <figcaption>
    A screenshot of residue-ui's Worktrees screen, with example data. <a href="https://github.com/whiteheap/residue-ui#screens">Every screen</a>
  </figcaption>
</figure>
