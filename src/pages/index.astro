---
import { Text } from "@cloudflare/kumo";
import Hero from "../components/Hero.astro";
import PageMeta from "../components/PageMeta.astro";
import ResidueStack from "../components/ResidueStack.astro";
import Tool from "../components/Tool.astro";
import Page from "../layouts/Page.astro";
import { description, hero, home, residue } from "../site";

const title = `Whiteheap · ${hero.title}`;
const url = "https://whiteheap.com/";
const organizationId = `${url}#organization`;
const websiteId = `${url}#website`;
const residueId = `${new URL(residue.website).href}#software`;

// One graph, on this page only: Whiteheap, this website and page, and each
// tool on the page with its source. Tool sites name Whiteheap as their
// publisher by organizationId. Each node is something the page shows.
// `pnpm run check` holds it to the standard; `pnpm run smoke` fetches each URL.
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": organizationId,
      name: "Whiteheap",
      url,
      logo: "https://whiteheap.com/apple-touch-icon.png",
      description,
      sameAs: ["https://github.com/whiteheap", "https://x.com/whiteheaphq"],
      // The contact page, linked in the footer: issues, security advisories, X.
      contactPoint: { "@type": "ContactPoint", contactType: "customer support", url: "https://whiteheap.com/contact" },
    },
    {
      "@type": "WebSite",
      "@id": websiteId,
      name: "Whiteheap",
      url,
      publisher: { "@id": organizationId },
    },
    {
      "@type": "WebPage",
      name: title,
      url,
      description,
      isPartOf: { "@id": websiteId },
      about: { "@id": organizationId },
    },
    {
      "@type": "SoftwareApplication",
      "@id": residueId,
      name: residue.name,
      description: `${residue.title} ${residue.lede}`,
      url: new URL(residue.website).href,
      applicationCategory: "DeveloperApplication",
      operatingSystem: "macOS, Linux, FreeBSD",
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      publisher: { "@id": organizationId },
    },
    {
      "@type": "SoftwareSourceCode",
      name: residue.name,
      codeRepository: residue.repository,
      programmingLanguage: "Rust",
      license: "https://opensource.org/license/mit",
      targetProduct: { "@id": residueId },
      publisher: { "@id": organizationId },
    },
  ],
};
---

<Page title={title}>
  <Fragment slot="head">
    <PageMeta title={title} description={description} path="/" markdown="/index.md" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <main>
    <Hero />

    <section class="section wrap split" aria-labelledby="mission">
      <h2 id="mission" class="label">mission</h2>
      <div class="prose">
        {home.mission.map((paragraph) => <Text size="lg">{paragraph}</Text>)}
      </div>
    </section>

    <section class="section wrap split" aria-labelledby="standard">
      <h2 id="standard" class="label">standard</h2>
      <div class="prose">
        {home.standard.map((paragraph) => <Text size="lg">{paragraph}</Text>)}
      </div>
    </section>

    <section class="section wrap split" aria-labelledby="tools">
      <h2 id="tools" class="label">tools</h2>
      <div class="tools">
        <Tool {...residue}>
          <ResidueStack slot="hero" />
        </Tool>
      </div>
    </section>

    <section class="section wrap split" aria-labelledby="name">
      <h2 id="name" class="label">name</h2>
      <div class="prose">
        {home.name.map((paragraph) => <Text size="lg">{paragraph}</Text>)}
      </div>
    </section>
  </main>
</Page>
