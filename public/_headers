# Response headers for every static asset. Cloudflare reads this file at
# deploy time and does not serve it. `pnpm run check` holds the text types
# here to the Whiteheap SEO standard; `pnpm run smoke` reads them live.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# robots.txt, llms.txt, security.txt and the IndexNow key file. Without this
# they are text/plain with no charset; RFC 9116 asks for utf-8 on security.txt.
/*.txt
  Content-Type: text/plain; charset=utf-8

# A tool's mark: a returning reader keeps it a day without asking again. Its
# name carries no hash, and a day-old mark still fits the page.
/tools/*
  Cache-Control: public, max-age=86400

# Markdown: each page's twin, /agents.md and the agent skills. Cloudflare
# does not give .md a type of its own.
/*.md
  Content-Type: text/markdown; charset=utf-8

# The homepage names its markdown twin, llms.txt, sitemap and agent catalog
# in Link headers (RFC 8288), for an agent that reads headers before HTML.
# Cloudflare joins repeated headers with commas.
/
  Link: </index.md>; rel="alternate"; type="text/markdown"
  Link: </llms.txt>; rel="describedby"; type="text/plain"
  Link: </sitemap.xml>; rel="sitemap"; type="application/xml"
  Link: </.well-known/ard.json>; rel="ard"; type="application/json"

# The agent discovery files: any agent, from any origin, may read them.
/.well-known/ard.json
  Access-Control-Allow-Origin: *
/.well-known/agent-skills/*
  Access-Control-Allow-Origin: *
